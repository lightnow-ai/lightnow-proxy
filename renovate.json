{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>apitree/renovate:python#v1.0.2",
    "github>apitree/renovate:docker#v1.0.2",
    "helpers:pinGitHubActionDigests",
    "default:automergeDigest",
    ":automergeStableNonMajor",
    ":configMigration",
    ":enableVulnerabilityAlerts",
    ":maintainLockFilesWeekly",
    "abandonments:recommended"
  ],
  "packageRules": [
    {
      "description": "Wait for normal PyPI releases to mature before automated adoption; vulnerability fixes remain immediate.",
      "matchDatasources": [
        "pypi"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Keep the published runtime on Python 3.12 and require human review for runtime updates.",
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.13",
      "automerge": false
    },
    {
      "description": "Release and CI workflow changes require human review because tag-only publishing paths do not run on pull requests.",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "description": "Keep JWT authentication library updates independently reviewable.",
      "matchPackageNames": [
        "pyjwt"
      ],
      "groupName": null,
      "groupSlug": null
    }
  ],
  "platformAutomerge": false
}
